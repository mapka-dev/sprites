  },
  "lint-staged": {
    "*.{js,ts,tsx}": "yarn lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@chyzwar/biome-config": "^0.4.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lerna-lite/cli": "^5.8.0",
    "@lerna-lite/publish": "^5.8.0",
    "@lerna-lite/version": "^5.8.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependenciesMeta": {
    "@mapnik/mapnik": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1"

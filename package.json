  "engines": {
    "node": "26.x"
  },
  "main": "index.js",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage",
    "bench": "vitest bench --run",
